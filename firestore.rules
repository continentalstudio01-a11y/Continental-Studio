rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global site settings / BioSite configuration
    // Public read access for visitors to render the site and theme correctly.
    // Write/update restricted strictly to authenticated administrators.
    match /biosite_data/main_settings {
      allow read: if true;
      allow write, create, update, delete: if request.auth != null;
    }

    // Default rule for any other collection/document: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
